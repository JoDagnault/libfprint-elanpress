+static void
+elanpress_calib_mean_cb (FpiUsbTransfer *transfer, FpDevice *dev,
+                         gpointer user_data, GError *error)
+{
+  FpiDeviceElanPress *self = FPI_DEVICE_ELANPRESS (dev);
+  unsigned int bg_mean = 0, n = elanpress_frame_size (self);
+
+  if (error)
+    {
+      fp_warn ("calib mean read failed: %s", error->message);
+      g_error_free (error);
+      fpi_ssm_next_state (transfer->ssm);
+      return;
+    }
+  /* same byte order the elan driver uses */
+  self->calib_mean = transfer->buffer[0] * 0xff + transfer->buffer[1];
+  for (unsigned int i = 0; i < n; i++)
+    bg_mean += self->background[i];
+  bg_mean /= n;
+  fp_dbg ("calib mean %u (raw %02x %02x), background mean %u, delta %d",
+          self->calib_mean, transfer->buffer[0], transfer->buffer[1],
+          bg_mean, (int) bg_mean - (int) self->calib_mean);
+  fpi_ssm_next_state (transfer->ssm);
+}
